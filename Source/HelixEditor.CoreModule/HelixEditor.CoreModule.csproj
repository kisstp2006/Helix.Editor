<Project Sdk="Microsoft.NET.Sdk">
  <!-- The editor's C# side: the bindings of its native module HelixEditor and the editor written in C# (menus, the main
       toolbar, the shell), over the engine's and the UI's C# sides. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Message methods are found by reflection, menu items too. -->
    <NoWarn>IDE0051;CS0169;CS0649</NoWarn>
    <RootNamespace>HelixEditor</RootNamespace>
    <AssemblyName>HelixEditor.CoreModule</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="HelixEngine.CoreModule">
      <HintPath>$(HelixCoreModule)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Helix.Mathematics">
      <HintPath>$([System.IO.Path]::GetDirectoryName($(HelixCoreModule)))/Helix.Mathematics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Helix.UI.Runtime">
      <HintPath>$(HelixUIRuntime)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Helix.Scripting.Runtime">
      <HintPath>$(HelixScriptingRuntime)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <!-- The pipelines' assemblies: loaded with the editor, their classes are the C# types of the pipelines' objects. -->
  <ItemGroup Condition="'$(HelixRenderPipelinesCore)' != ''">
    <Reference Include="Helix.RenderPipelines.Core.Runtime">
      <HintPath>$(HelixRenderPipelinesCore)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Helix.RenderPipelines.Standard.Runtime">
      <HintPath>$(HelixRenderPipelinesStandard)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Helix.RenderPipelines.Physical.Runtime">
      <HintPath>$(HelixRenderPipelinesPhysical)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <!-- The C# bindings of the native module HelixEditor (Helix.Bindgen's output). -->
  <ItemGroup Condition="'$(HelixModuleBindings)' != ''">
    <Compile Include="$(HelixModuleBindings)" />
  </ItemGroup>
</Project>
