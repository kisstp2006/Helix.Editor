<Project Sdk="Microsoft.NET.Sdk">
  <!-- The editor's C# tests, run inside the editor in batch mode by -executeMethod HelixEditor.Tests.EditorTests.Run.
       Built only for the tests, into the build's Managed/ folder. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Message methods are found by reflection, menu items too. -->
    <NoWarn>IDE0051;CS0169;CS0649</NoWarn>
    <RootNamespace>HelixEditor.Tests</RootNamespace>
    <AssemblyName>HelixEditor.Tests</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="HelixEngine.CoreModule">
      <HintPath>$(HelixCoreModule)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Helix.Mathematics">
      <HintPath>$([System.IO.Path]::GetDirectoryName($(HelixCoreModule)))/Helix.Mathematics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Helix.UI.Runtime">
      <HintPath>$(HelixUIRuntime)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Helix.Scripting.Runtime">
      <HintPath>$(HelixScriptingRuntime)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="HelixEditor.CoreModule">
      <HintPath>$(HelixEditorCoreModule)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
