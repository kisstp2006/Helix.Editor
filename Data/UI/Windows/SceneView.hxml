<HXML>
  <!-- The Scene view: its top row (the overlays docked in the top toolbar zone: View Options, Grid and Snap, Gizmos)
       over the viewport, whose overlay canvas holds the others. -->
  <Element name="overlay-top" class="window-toolbar overlay-top"/>
  <Element name="scene-viewport" class="window-content viewport scene-viewport"/>
</HXML>
