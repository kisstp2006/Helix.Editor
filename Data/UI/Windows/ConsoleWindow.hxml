<HXML>
  <!-- The Console: its toolbar (Clear, Collapse, Error Pause, the search, the counts) over the log. -->
  <Element class="window-toolbar">
    <Button class="window-dropdown plain"><Label text="Clear"/><Element class="icon arrow-down"/></Button>
    <Element class="window-separator"/>
    <Button class="window-tool"><Label text="Collapse"/></Button>
    <Button class="window-tool"><Label text="Error Pause"/></Button>
    <Element class="window-fill"/>
    <Element class="window-search"><Element class="icon icon-search"/><Label class="window-search-text" text=""/></Element>
    <Button class="window-tool on"><Element class="icon icon-info"/><Label text="0"/></Button>
    <Button class="window-tool on"><Element class="icon icon-warning"/><Label text="0"/></Button>
    <Button class="window-tool on"><Element class="icon icon-error"/><Label text="0"/></Button>
  </Element>
  <Element class="window-content"><Label class="window-note" text="The log comes with step 6."/></Element>
</HXML>
