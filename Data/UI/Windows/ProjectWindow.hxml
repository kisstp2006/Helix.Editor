<HXML>
  <!-- The Project window: its toolbar (Create, the search, lock, menu), the folder tree and the folder's assets. -->
  <Element class="window-toolbar">
    <Button class="window-dropdown plain"><Label text="Create"/><Element class="icon arrow-down"/></Button>
    <Element class="window-fill"/>
    <Element class="window-search"><Element class="icon icon-search"/><Label class="window-search-text" text=""/></Element>
    <Button class="window-tool"><Element class="icon icon-lock"/></Button>
    <Button class="window-tool"><Element class="icon icon-menu"/></Button>
  </Element>
  <Element class="project-body">
    <Element class="project-tree">
      <Label class="project-folder" text="Favorites"/>
      <Label class="project-folder" text="Assets"/>
    </Element>
    <Element class="project-grid">
      <Label class="project-breadcrumb" text="Assets"/>
      <Label class="window-note" text="The project's assets come with step 6."/>
    </Element>
  </Element>
</HXML>
