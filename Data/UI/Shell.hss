/* The editor's shell over the skin's parts (.hx-*) and colors (--hx-*). */
.shell {
    flex-grow: 1;
    background-color: var(--hx-window);
    -helix-font-family: "Segoe UI", "Noto Sans", "DejaVu Sans", "Liberation Sans";
    font-size: 13px;
    color: var(--hx-text);
}

/* The title bar: the logo, the window's title, the caption buttons. */
.title-bar { flex-direction: row; align-items: center; height: 32px; flex-shrink: 0; padding-left: 8px; }
.logo { width: 22px; height: 22px; margin-right: 8px; background-image: url("../Images/HelixLogo.png"); -helix-background-scale-mode: scale-to-fit; }
.title { font-size: 14px; color: var(--hx-text-strong); }
.caption-fill { flex-grow: 1; align-self: stretch; }
.caption-buttons { flex-direction: row; align-self: stretch; }
.caption-button { width: 46px; margin: 0px; padding: 0px; border-width: 0px; background-color: rgba(0, 0, 0, 0); align-items: center; justify-content: center; }
.caption-button:hover { background-image: url("../Skin/HelixClassic/CaptionButtonHover.png"); }
.caption-button.close:hover { background-image: url("../Skin/HelixClassic/CaptionCloseHover.png"); }

.icon { width: 16px; height: 16px; flex-shrink: 0; -helix-background-scale-mode: scale-to-fit; -helix-background-image-tint-color: var(--hx-text); }
.icon.minimize { background-image: url("../Skin/Icons/Minimize.png"); }
.icon.maximize { background-image: url("../Skin/Icons/Maximize.png"); }
.icon.restore { background-image: url("../Skin/Icons/Restore.png"); }
.icon.close { background-image: url("../Skin/Icons/Close.png"); }
.icon.lock { background-image: url("../Skin/Icons/Lock.png"); }
.icon.arrow-down { width: 10px; height: 10px; background-image: url("../Skin/Icons/ArrowDown.png"); }

/* The menu bar: its titles, lit while hovered or open. */
.menu-bar { flex-direction: row; align-items: stretch; height: 24px; flex-shrink: 0; padding-left: 4px; }
.menu-title { padding-left: 9px; padding-right: 9px; -helix-text-align: middle-center; color: var(--hx-text); }
.menu-title:hover, .menu-title.open { background-image: url("../Skin/HelixClassic/MenuItemHover.png"); -helix-slice-left: 6; -helix-slice-top: 6; -helix-slice-right: 6; -helix-slice-bottom: 6; color: var(--hx-accent-text); }

/* The main toolbar: three groups (left, middle, right) of the registry's elements. */
.main-toolbar { flex-direction: row; align-items: center; height: 42px; flex-shrink: 0; padding-left: 8px; padding-right: 8px; }
.toolbar-group { flex-direction: row; align-items: center; flex-basis: 0px; flex-grow: 1; }
.toolbar-group.middle { justify-content: center; }
.toolbar-group.right { justify-content: flex-end; }
.toolbar-strip { flex-direction: row; margin-right: 10px; }
.tool-button { width: 34px; height: 28px; margin: 0px; margin-right: 1px; padding: 0px; border-width: 0px; align-items: center; justify-content: center; }
.tool-button:hover { background-image: url("../Skin/HelixClassic/ButtonHover.png"); }
.tool-button:active { background-image: url("../Skin/HelixClassic/ButtonPressed.png"); }
.tool-button.on { background-image: url("../Skin/HelixClassic/ButtonOn.png"); }
.tool-button .icon { width: 20px; height: 20px; }
.tool-button.on .icon { -helix-background-image-tint-color: var(--hx-accent-text); }
.toolbar-dropdown { flex-direction: row; align-items: center; height: 28px; min-width: 110px; margin-left: 8px; padding-left: 10px; padding-right: 8px; border-width: 0px; }
.toolbar-dropdown:hover { background-image: url("../Skin/HelixClassic/ButtonHover.png"); }
.toolbar-dropdown Label { flex-grow: 1; color: var(--hx-text); }

/* The dock area: windows come with docking; until then the panel's color. */
.dock-root { flex-grow: 1; flex-direction: row; margin: 2px; }

/* The status bar. */
.status-bar { flex-direction: row; align-items: center; height: 30px; flex-shrink: 0; padding-left: 10px; padding-right: 10px; }
.status-logo { width: 20px; height: 20px; margin-right: 8px; background-image: url("../Images/HelixLogo.png"); -helix-background-scale-mode: scale-to-fit; }
.status-text { color: var(--hx-text); }
.status-text.strong { color: var(--hx-text-strong); }
.status-separator { width: 1px; height: 16px; margin-left: 10px; margin-right: 10px; background-color: var(--hx-text-dim); }
.status-fill { flex-grow: 1; }
.status-progress { width: 0px; height: 6px; margin-right: 10px; background-color: var(--hx-accent); }
.status-lock { -helix-background-image-tint-color: var(--hx-text-dim); }

/* The popup menus' look (the dropdown menu's own classes). */
.helix-dropdown-menu__container-outer { background-image: url("../Skin/HelixClassic/Menu.png"); -helix-slice-left: 16; -helix-slice-top: 16; -helix-slice-right: 16; -helix-slice-bottom: 16; padding: 6px; }

/* Docking: splits, splitters, dock areas with their tab strips, floating containers, the drop indicator. */
.dock-root { position: relative; }
.dock-docked { flex-grow: 1; flex-direction: row; }
.dock-docked > * { flex-grow: 1; }
.dock-floating-layer { position: absolute; left: 0px; top: 0px; right: 0px; bottom: 0px; }
.dock-split { flex-direction: row; align-items: stretch; }
.dock-split.column { flex-direction: column; }
.dock-splitter { flex-shrink: 0; background-color: var(--hx-window); }
.dock-splitter.row { width: 4px; cursor: resize-horizontal; }
.dock-splitter.column { height: 4px; cursor: resize-vertical; }
.dock-area { flex-direction: column; min-width: 60px; min-height: 60px; }
.dock-tab-strip { flex-direction: row; align-items: flex-end; height: 30px; flex-shrink: 0; padding-left: 2px; }
.dock-tab { flex-direction: row; align-items: center; height: 27px; padding-left: 10px; padding-right: 14px; margin-right: 1px; }
.dock-tab.active { height: 29px; }
.dock-tab-icon { width: 16px; height: 16px; margin-right: 6px; -helix-background-scale-mode: scale-to-fit; -helix-background-image-tint-color: var(--hx-text); }
.dock-tab-label { color: var(--hx-text-dim); font-size: 13px; }
.dock-tab.active .dock-tab-label { color: var(--hx-text-strong); }
.dock-tab-fill { flex-grow: 1; }
.dock-content { flex-grow: 1; flex-direction: column; }
.editor-window-root { flex-grow: 1; flex-direction: column; }
.dock-floating { position: absolute; flex-direction: column; padding: 12px; }
.dock-floating > .dock-area, .dock-floating > .dock-split { flex-grow: 1; }
.dock-drop-indicator { position: absolute; background-color: rgba(58, 142, 230, 0.25); border-width: 2px; border-color: var(--hx-accent); }

/* The windows' toolbars and content. */
.window-toolbar { flex-direction: row; align-items: center; height: 30px; flex-shrink: 0; padding-left: 6px; padding-right: 6px; }
.window-dropdown { flex-direction: row; align-items: center; height: 22px; min-width: 70px; margin: 0px; margin-right: 6px; padding-left: 8px; padding-right: 6px; border-width: 0px; }
.window-dropdown Label { flex-grow: 1; color: var(--hx-text); }
.window-tool { flex-direction: row; align-items: center; justify-content: center; height: 22px; min-width: 26px; margin: 0px; margin-right: 4px; padding-left: 5px; padding-right: 5px; border-width: 0px; }
.window-tool Label { color: var(--hx-text); margin-left: 2px; }
.window-tool.on { background-image: url("../Skin/HelixClassic/ButtonOn.png"); -helix-slice-left: 7; -helix-slice-top: 7; -helix-slice-right: 7; -helix-slice-bottom: 7; }
.window-tool .icon { width: 16px; height: 16px; }
.window-search { flex-direction: row; align-items: center; height: 22px; min-width: 160px; flex-grow: 0.4; margin-left: 6px; margin-right: 6px; padding-left: 6px; }
.window-search .icon { width: 14px; height: 14px; -helix-background-image-tint-color: var(--hx-text-dim); }
.window-search-text { color: var(--hx-text-dim); margin-left: 4px; }
.window-fill { flex-grow: 1; }
.window-content { flex-grow: 1; padding: 10px; }
.window-content.viewport { background-color: #2b3440; align-items: center; justify-content: center; }
.window-note { color: var(--hx-text-dim); -helix-font-style: italic; }
.icon-error { -helix-background-image-tint-color: #e05252; }
.icon-warning { -helix-background-image-tint-color: #e8b33a; }
.icon-info { -helix-background-image-tint-color: #c8c8c8; }
.project-body { flex-grow: 1; flex-direction: row; }
.project-tree { width: 200px; flex-shrink: 0; padding: 8px; border-right-width: 1px; border-right-color: var(--hx-separator); }
.project-folder { padding: 3px; color: var(--hx-text); }
.project-grid { flex-grow: 1; padding: 8px; }
.project-breadcrumb { color: var(--hx-text-strong); margin-bottom: 10px; }
