/* The editor's shell over the skin's parts (.hx-*), colors and sizes (--hx-*). */
.shell {
    flex-grow: 1;
    background-color: var(--hx-window);
    -helix-font-family: "Segoe UI", "Noto Sans", "DejaVu Sans", "Liberation Sans";
    font-size: var(--hx-font-size);
    color: var(--hx-text);
}

/* The editor's buttons draw the skin's images: the theme's button box (its minimum height, margins, border, colors
   of its states) does not apply to them. */
.shell .helix-button { min-height: 0px; margin: 0px; border-width: 0px; border-radius: 0px; background-color: rgba(0, 0, 0, 0); }
.shell .helix-button:hover, .shell .helix-button:active, .shell .helix-button:focus { background-color: rgba(0, 0, 0, 0); border-width: 0px; }

/* The title bar: the logo, the window's title, the caption buttons. */
.title-bar { flex-direction: row; align-items: center; height: var(--hx-title-bar-height); flex-shrink: 0; padding-left: 6px; }
.logo { width: var(--hx-logo-size); height: var(--hx-logo-size); margin-right: 6px; background-image: url("../Images/HelixLogo.png"); -helix-background-scale-mode: scale-to-fit; }
.title { font-size: var(--hx-title-font-size); color: var(--hx-text-strong); }
.caption-fill { flex-grow: 1; align-self: stretch; }
.caption-buttons { flex-direction: row; align-self: stretch; }
.caption-button { width: var(--hx-caption-button-width); margin: 0px; padding: 0px; border-width: 0px; background-color: rgba(0, 0, 0, 0); align-items: center; justify-content: center; }
.caption-button .icon { width: var(--hx-caption-icon-size); height: var(--hx-caption-icon-size); }
.caption-button:hover { background-image: url("../Skin/HelixClassic/CaptionButtonHover.png"); }
.caption-button.close:hover { background-image: url("../Skin/HelixClassic/CaptionCloseHover.png"); }

.icon { width: 16px; height: 16px; flex-shrink: 0; -helix-background-scale-mode: scale-to-fit; -helix-background-image-tint-color: var(--hx-text); }
.icon.minimize { background-image: url("../Skin/Icons/Minimize.png"); }
.icon.maximize { background-image: url("../Skin/Icons/Maximize.png"); }
.icon.restore { background-image: url("../Skin/Icons/Restore.png"); }
.icon.close { background-image: url("../Skin/Icons/Close.png"); }
.icon.lock { background-image: url("../Skin/Icons/Lock.png"); }
.icon.arrow-down { width: 9px; height: 9px; background-image: url("../Skin/Icons/ArrowDown.png"); }

/* The menu bar: its titles, lit while hovered or open. */
.menu-bar { flex-direction: row; align-items: stretch; height: var(--hx-menu-bar-height); flex-shrink: 0; padding-left: 2px; }
.menu-title { padding-left: var(--hx-menu-title-padding); padding-right: var(--hx-menu-title-padding); -helix-text-align: middle-center; color: var(--hx-text); }
.menu-title:hover, .menu-title.open { background-image: url("../Skin/HelixClassic/MenuItemHover.png"); -helix-slice-left: 6; -helix-slice-top: 6; -helix-slice-right: 6; -helix-slice-bottom: 6; color: var(--hx-accent-text); }

/* The main toolbar: three groups (left, middle, right) of the registry's elements. */
.main-toolbar { flex-direction: row; align-items: center; height: var(--hx-toolbar-height); flex-shrink: 0; padding-left: 6px; padding-right: 6px; }
.toolbar-group { flex-direction: row; align-items: center; flex-basis: 0px; flex-grow: 1; }
.toolbar-group.middle { justify-content: center; }
.toolbar-group.right { justify-content: flex-end; }
.toolbar-strip { flex-direction: row; margin-right: var(--hx-toolbar-gap); }
.tool-button { width: var(--hx-tool-button-width); height: var(--hx-tool-button-height); margin: 0px; margin-right: 1px; padding: 0px; border-width: 0px; align-items: center; justify-content: center; }
.tool-button:hover { background-image: url("../Skin/HelixClassic/ButtonHover.png"); }
.tool-button:active { background-image: url("../Skin/HelixClassic/ButtonPressed.png"); }
.tool-button.on { background-image: url("../Skin/HelixClassic/ButtonOn.png"); }
.tool-button .icon { width: var(--hx-tool-icon-size); height: var(--hx-tool-icon-size); }
.tool-button.on .icon { -helix-background-image-tint-color: var(--hx-accent-text); }
.tool-button.with-text { width: auto; flex-direction: row; padding-left: 4px; padding-right: 6px; }
.tool-button.with-text Label { margin-left: 2px; color: var(--hx-text); }
.toolbar-dropdown { flex-direction: row; align-items: center; height: var(--hx-toolbar-dropdown-height); min-width: var(--hx-toolbar-dropdown-width); margin-left: var(--hx-toolbar-gap); padding-left: 8px; padding-right: 6px; border-width: 0px; }
.toolbar-dropdown:hover { background-image: url("../Skin/HelixClassic/ButtonHover.png"); }
.toolbar-dropdown Label { flex-grow: 1; color: var(--hx-text); }

/* The dock area. */
.dock-root { flex-grow: 1; flex-direction: row; margin: 1px; }

/* The status bar. */
.status-bar { flex-direction: row; align-items: center; height: var(--hx-status-bar-height); flex-shrink: 0; padding-left: 6px; padding-right: 6px; }
.status-logo { width: var(--hx-status-logo-size); height: var(--hx-status-logo-size); margin-right: 6px; background-image: url("../Images/HelixLogo.png"); -helix-background-scale-mode: scale-to-fit; }
.status-text { color: var(--hx-text); font-size: var(--hx-small-font-size); }
.status-text.strong { color: var(--hx-text-strong); }
.status-separator { width: 1px; height: 12px; margin-left: 8px; margin-right: 8px; background-color: var(--hx-text-dim); }
.status-fill { flex-grow: 1; }
.status-progress { width: 0px; height: 5px; margin-right: 8px; background-color: var(--hx-accent); }
.status-lock { width: 12px; height: 12px; -helix-background-image-tint-color: var(--hx-text-dim); }

/* The popup menus (the dropdown menu's own classes): the skin's menu box, its items compact, lit while highlighted. */
.helix-base-dropdown__container-outer { background-image: url("../Skin/HelixClassic/Menu.png"); -helix-slice-left: 16; -helix-slice-top: 16; -helix-slice-right: 16; -helix-slice-bottom: 16; background-color: rgba(0, 0, 0, 0); border-width: 0px; padding: var(--hx-menu-padding); padding-bottom: 8px; padding-right: 8px; }
.helix-base-dropdown__item { min-height: var(--hx-menu-item-height); padding: 0px 10px 0px 4px; font-size: var(--hx-font-size); }
.helix-base-dropdown__item:hover, .helix-base-dropdown__item--highlighted { background-color: rgba(0, 0, 0, 0); background-image: url("../Skin/HelixClassic/MenuItemHover.png"); -helix-slice-left: 6; -helix-slice-top: 6; -helix-slice-right: 6; -helix-slice-bottom: 6; }
.helix-base-dropdown__item:hover .helix-base-dropdown__label, .helix-base-dropdown__item--highlighted .helix-base-dropdown__label { color: var(--hx-accent-text); }
.helix-base-dropdown__item:disabled:hover { background-image: none; }
.helix-base-dropdown__item:disabled:hover .helix-base-dropdown__label { color: var(--hx-text-dim); }
.helix-base-dropdown__label { color: var(--hx-text); }
.helix-base-dropdown__item:disabled .helix-base-dropdown__label { color: #6c6c6c; }
.helix-base-dropdown__separator { height: 1px; margin: 3px 4px 3px 4px; background-color: var(--hx-separator); border-bottom-width: 1px; border-bottom-color: #ffffff10; }

/* Docking: splits, splitters, dock areas with their tab strips, floating containers, the drop indicator. The
   floating sizes and a new window's place are read by the dock as custom properties. */
.dock-root { position: relative; }
.dock-docked { flex-grow: 1; flex-direction: row; }
.dock-docked > * { flex-grow: 1; }
.dock-floating-layer { position: absolute; left: 0px; top: 0px; right: 0px; bottom: 0px; }
.dock-split { flex-direction: row; align-items: stretch; }
.dock-split.column { flex-direction: column; }
.dock-splitter { flex-shrink: 0; background-color: var(--hx-window); }
.dock-splitter.row { width: var(--hx-splitter-size); cursor: resize-horizontal; }
.dock-splitter.column { height: var(--hx-splitter-size); cursor: resize-vertical; }
.dock-area { flex-direction: column; min-width: var(--hx-area-min-size); min-height: var(--hx-area-min-size); }
.dock-tab-strip { flex-direction: row; align-items: flex-end; height: var(--hx-tab-strip-height); flex-shrink: 0; padding-left: 2px; }
.dock-tab { flex-direction: row; align-items: center; height: var(--hx-tab-height); padding-left: var(--hx-tab-padding); padding-right: var(--hx-tab-padding); margin-right: 1px; }
.dock-tab.active { height: var(--hx-tab-active-height); }
.dock-tab-icon { width: var(--hx-tab-icon-size); height: var(--hx-tab-icon-size); margin-right: 4px; -helix-background-scale-mode: scale-to-fit; -helix-background-image-tint-color: var(--hx-text); }
.dock-tab-label { color: var(--hx-text-dim); font-size: var(--hx-font-size); }
.dock-tab.active .dock-tab-label { color: var(--hx-text-strong); }
.dock-tab-close { width: var(--hx-tab-close-size); height: var(--hx-tab-close-size); margin-left: 4px; margin-right: -4px; background-image: url("../Skin/Icons/Close.png"); -helix-background-scale-mode: scale-to-fit; -helix-background-image-tint-color: var(--hx-text-dim); opacity: 0; }
.dock-tab.active .dock-tab-close, .dock-tab:hover .dock-tab-close { opacity: 1; }
.dock-tab-close:hover { -helix-background-image-tint-color: var(--hx-text-strong); background-color: #ffffff20; border-radius: 2px; }
.dock-tab-fill { flex-grow: 1; }
.dock-area-menu { width: 14px; height: 14px; align-self: center; margin-right: 4px; -helix-background-image-tint-color: var(--hx-text-dim); }
.dock-area-menu:hover { -helix-background-image-tint-color: var(--hx-text-strong); }
.dock-content { flex-grow: 1; flex-direction: column; }
.editor-window-root { flex-grow: 1; flex-direction: column; }
.editor-window-gui { flex-grow: 1; }
.dock-floating { position: absolute; flex-direction: column; padding: var(--hx-float-padding); }
.dock-floating > .dock-area, .dock-floating > .dock-split { flex-grow: 1; }
.dock-drop-indicator { position: absolute; background-color: rgba(58, 142, 230, 0.25); border-width: 2px; border-color: var(--hx-accent); }

/* A floating window: the container fills it inside a border. */
.floating-window { border-width: 1px; border-color: var(--hx-separator); }
.floating-window .dock-root { margin: 0px; }

/* A popup menu's window: the menu's boxes plain (the window is their size, no room for a drop shadow). */
.popup-window { background-color: var(--hx-panel); }
.popup-window .helix-base-dropdown__container-outer { background-image: none; background-color: var(--hx-panel); border-width: 1px; border-color: #121212; padding: 2px; }

/* The windows' toolbars and content. */
.window-toolbar { flex-direction: row; align-items: center; height: var(--hx-window-toolbar-height); flex-shrink: 0; padding-left: 3px; padding-right: 3px; background-image: url("../Skin/HelixClassic/WindowToolbar.png"); -helix-slice-left: 4; -helix-slice-top: 4; -helix-slice-right: 4; -helix-slice-bottom: 4; }
/* The windows' toolbar controls are flat (the main toolbar's are raised): a dropdown a sunken box (plain: its text and
   arrow only), a tool lit while hovered and sunken while on, the search field a sunken pill. */
.window-dropdown { flex-direction: row; align-items: center; height: var(--hx-window-control-height); min-width: var(--hx-window-dropdown-width); margin: 0px; margin-right: 3px; padding-left: 6px; padding-right: 4px; border-width: 0px; background-color: rgba(0, 0, 0, 0); background-image: url("../Skin/HelixClassic/ToolbarDropdown.png"); -helix-slice-left: 4; -helix-slice-top: 4; -helix-slice-right: 4; -helix-slice-bottom: 4; }
.window-dropdown:hover { background-image: url("../Skin/HelixClassic/ToolbarButtonHover.png"); }
.window-dropdown.plain { min-width: 0px; background-image: none; padding-left: 4px; }
.window-dropdown.plain:hover { background-image: url("../Skin/HelixClassic/ToolbarButtonHover.png"); }
.window-dropdown.wide { min-width: var(--hx-window-dropdown-wide-width); }
.window-dropdown Label { flex-grow: 1; color: var(--hx-text); font-size: var(--hx-small-font-size); margin-right: 4px; }
/* The Create menus' plus (the reference's toolbars show it in place of the word). */
.window-dropdown .icon.icon-plus { width: 13px; height: 13px; margin-right: 1px; -helix-background-image-tint-color: var(--hx-text); }
.window-search.wide { flex-grow: 1; min-width: 40px; }
.window-dropdown .icon.arrow-down { width: 8px; height: 8px; -helix-background-image-tint-color: var(--hx-text-dim); }
.window-tool { flex-direction: row; align-items: center; justify-content: center; height: var(--hx-window-control-height); min-width: 22px; margin: 0px; margin-right: 1px; padding-left: 4px; padding-right: 4px; border-width: 0px; background-color: rgba(0, 0, 0, 0); background-image: none; }
.window-tool:hover { background-image: url("../Skin/HelixClassic/ToolbarButtonHover.png"); -helix-slice-left: 4; -helix-slice-top: 4; -helix-slice-right: 4; -helix-slice-bottom: 4; }
.window-tool.on { background-image: url("../Skin/HelixClassic/ToolbarButtonOn.png"); -helix-slice-left: 4; -helix-slice-top: 4; -helix-slice-right: 4; -helix-slice-bottom: 4; }
.window-tool.on .icon { -helix-background-image-tint-color: var(--hx-accent); }
.window-tool Label { color: var(--hx-text); margin-left: 2px; font-size: var(--hx-small-font-size); }
.window-tool .icon { width: var(--hx-window-icon-size); height: var(--hx-window-icon-size); }
.window-separator { width: 1px; height: 14px; margin-left: 3px; margin-right: 4px; background-color: #00000060; border-right-width: 1px; border-right-color: #ffffff0c; }
.window-search { flex-direction: row; align-items: center; height: var(--hx-window-control-height); min-width: var(--hx-window-search-width); flex-grow: 0.4; margin-left: 4px; margin-right: 4px; padding-left: 7px; background-image: url("../Skin/HelixClassic/SearchField.png"); -helix-slice-left: 9; -helix-slice-top: 9; -helix-slice-right: 9; -helix-slice-bottom: 9; }
.window-search .icon { width: 11px; height: 11px; -helix-background-image-tint-color: var(--hx-text-dim); }
.window-search-text { color: var(--hx-text-dim); margin-left: 4px; font-size: var(--hx-small-font-size); }
.window-fill { flex-grow: 1; }
.window-content { flex-grow: 1; padding: var(--hx-window-padding); }
.window-content.viewport { background-color: #2b3440; align-items: center; justify-content: center; }
.window-note { color: var(--hx-text-dim); -helix-font-style: italic; }
.icon-error { -helix-background-image-tint-color: #e05252; }
.icon-warning { -helix-background-image-tint-color: #e8b33a; }
.icon-info { -helix-background-image-tint-color: #c8c8c8; }
.project-body { flex-grow: 1; flex-direction: row; }
.project-tree { width: 180px; flex-shrink: 0; padding: var(--hx-window-padding); border-right-width: 1px; border-right-color: var(--hx-separator); }
.project-folder { padding: 2px; color: var(--hx-text); }
.project-grid { flex-grow: 1; padding: var(--hx-window-padding); }
.project-breadcrumb { color: var(--hx-text-strong); margin-bottom: 6px; }

/* The Hierarchy: its rows (a scene's header, its objects; the inactive ones dim), the field of a rename, the search. */
.window-search-field { flex-grow: 1; margin: 0px; padding: 0px; border-width: 0px; background-color: rgba(0,0,0,0); }
.window-search--focused { border-width: 1px; border-color: var(--hx-accent); border-radius: 3px; padding-left: 6px; }
.window-search--focused .icon { -helix-background-image-tint-color: var(--hx-text); }
.window-search-field .helix-text-input__caret { width: 1px; background-color: var(--hx-text-strong); }
.window-search-field .helix-text-input__selection { background-color: var(--hx-selection); }
.window-search-field > * { border-width: 0px; background-color: rgba(0,0,0,0); color: var(--hx-text); font-size: var(--hx-small-font-size); padding-top: 0px; padding-bottom: 0px; min-height: 0px; }
.hierarchy-content { padding: 0px; }
.hierarchy-tree { flex-grow: 1; }
.hierarchy-row { flex-direction: row; align-items: center; flex-grow: 1; height: var(--hx-hierarchy-row-height); }
.hierarchy-icon { width: var(--hx-window-icon-size); height: var(--hx-window-icon-size); margin-right: 4px; -helix-background-image-tint-color: var(--hx-text-dim); }
.hierarchy-name { color: var(--hx-text); font-size: var(--hx-font-size); }
.hierarchy-scene { background-color: var(--hx-panel-dark); }
.hierarchy-scene .hierarchy-name { color: var(--hx-text-strong); -helix-font-style: bold; }
.hierarchy-inactive .hierarchy-name { color: var(--hx-text-dim); }
.hierarchy-inactive .hierarchy-icon { opacity: 0.5; }
.hierarchy-rename { flex-grow: 1; margin: 0px; min-height: 0px; height: var(--hx-hierarchy-row-height); }
.hierarchy-tree .helix-collection-view__item--selected { background-color: var(--hx-selection); }
.hierarchy-tree .helix-collection-view__item--drag-hover { background-color: var(--hx-accent); }
.hierarchy-tree .helix-tree-view__item-indent { width: var(--hx-hierarchy-indent); }


/* The Inspector: the selection's header (a GameObject's active toggle, name, static, tag and layer; an asset's icon,
   name and type), each component under its raised title bar (foldout, icon, enabled, name, menu), its fields' labels
   of one width; the Add Component button and its list. */
.inspector { padding: 0px; }
.inspector-content { flex-direction: column; padding-bottom: 12px; }
.inspector-note { color: var(--hx-text-dim); -helix-font-style: italic; margin: 6px; white-space: normal; }
.inspector-header { flex-direction: column; padding: 4px; padding-left: 6px; border-bottom-width: 1px; border-bottom-color: var(--hx-separator); }
.inspector-header-row { flex-direction: row; align-items: center; min-height: 20px; }
.inspector-header-icon { width: 28px; height: 28px; margin-right: 4px; -helix-background-scale-mode: scale-to-fit; -helix-background-image-tint-color: var(--hx-text-dim); }
.inspector-active { margin-right: 4px; }
.inspector-name { flex-grow: 1; margin-right: 6px; }
.inspector-static .helix-toggle__text { color: var(--hx-text); font-size: var(--hx-small-font-size); }
.inspector-tag, .inspector-layer { flex-grow: 1; flex-basis: 0px; margin-left: 4px; }
.inspector-object-name { flex-grow: 1; color: var(--hx-text-strong); -helix-font-style: bold; }
.inspector-object-type { color: var(--hx-text-dim); font-size: var(--hx-small-font-size); margin-right: 4px; }
.inspector-titlebar { flex-direction: row; align-items: center; height: var(--hx-inspector-titlebar-height); padding-left: 2px; padding-right: 4px; background-image: url("../Skin/HelixClassic/Header.png"); -helix-slice-left: 6; -helix-slice-top: 6; -helix-slice-right: 6; -helix-slice-bottom: 6; }
.inspector-foldout { width: 12px; height: 12px; margin-right: 2px; -helix-background-image-tint-color: var(--hx-text-dim); }
.inspector-component-icon { width: 16px; height: 16px; margin-right: 4px; -helix-background-scale-mode: scale-to-fit; -helix-background-image-tint-color: var(--hx-text); }
.inspector-component-enabled { margin-right: 2px; margin-left: 0px; }
.inspector-component-name { color: var(--hx-text-strong); -helix-font-style: bold; }
.inspector-component-menu { width: 14px; height: 14px; -helix-background-image-tint-color: var(--hx-text-dim); }
.inspector-component-menu:hover { -helix-background-image-tint-color: var(--hx-text-strong); }
.inspector-component-body, .inspector-object-body { padding: 4px; padding-left: 16px; padding-right: 6px; padding-bottom: 6px; }
.inspector .helix-base-field { margin-top: 1px; margin-bottom: 1px; min-height: 18px; }
/* Labels take a share of the width (at most the skin's), a vector's part labels their letter's. */
.inspector .helix-base-field > .helix-base-field__label { width: 40%; min-width: 70px; max-width: var(--hx-inspector-label-width); color: var(--hx-text); font-size: var(--hx-font-size); }
.inspector .helix-composite-field__field > .helix-base-field__label { width: auto; min-width: 12px; flex-shrink: 0; color: var(--hx-text-dim); }
.inspector .inspector-static > .helix-base-field__label { width: auto; min-width: 0px; margin-right: 3px; }
.inspector .inspector-tag > .helix-base-field__label, .inspector .inspector-layer > .helix-base-field__label { width: auto; min-width: 0px; margin-right: 4px; flex-shrink: 0; overflow: visible; }
.inspector-add-row { flex-direction: row; justify-content: center; padding: 10px; border-top-width: 1px; border-top-color: var(--hx-separator); }
.inspector-add-component { width: 230px; height: 22px; }
.dock-area-button { width: 14px; height: 14px; align-self: center; margin-right: 4px; }

.add-component-popup { flex-direction: column; padding: 4px; background-image: url("../Skin/HelixClassic/Menu.png"); -helix-slice-left: 10; -helix-slice-top: 10; -helix-slice-right: 10; -helix-slice-bottom: 10; }
.add-component-title { -helix-text-align: middle-center; color: var(--hx-text-strong); -helix-font-style: bold; padding: 3px; }
.add-component-popup .window-search { margin-bottom: 4px; min-width: 0px; flex-grow: 0; }
.add-component-list { flex-grow: 1; flex-shrink: 1; }
.add-component-group { color: var(--hx-text-dim); font-size: var(--hx-small-font-size); padding: 4px; padding-left: 6px; border-top-width: 1px; border-top-color: var(--hx-separator); }
.add-component-row { flex-direction: row; align-items: center; height: 20px; padding-left: 6px; }
.add-component-row--highlight { background-image: url("../Skin/HelixClassic/MenuItemHover.png"); -helix-slice-left: 6; -helix-slice-top: 6; -helix-slice-right: 6; -helix-slice-bottom: 6; }
.add-component-icon { width: 14px; height: 14px; margin-right: 6px; -helix-background-scale-mode: scale-to-fit; -helix-background-image-tint-color: var(--hx-text); }
.add-component-name { color: var(--hx-text); }
.add-component-row--highlight .add-component-name { color: var(--hx-accent-text); }

/* The Scene view: its camera's picture fills the viewport. */
.scene-viewport { padding: 0px; -helix-background-scale-mode: stretch-to-fill; }
.scene-viewport { position: relative; }
.scene-orientation-label { position: absolute; left: 0px; right: 0px; bottom: 0px; -helix-text-align: middle-center; color: var(--hx-text-strong); font-size: var(--hx-small-font-size); }

/* Overlays: in a window's top row a toolbar overlay is part of the classic row (its grip the separator after it);
   at the view's sides and floating a toolbar is a dark strip with a dotted grip; a panel is a box with a header. */
.overlay-top { padding-right: 3px; }
.overlay-zone { padding: 0px; }
.overlay-left-toolbar, .overlay-right-toolbar, .overlay-left-column, .overlay-right-column { padding: 4px; }
.overlay-bottom { padding: 4px; }
.overlay-toolbar-content { padding: 0px; }
.overlay-in-row { background-color: rgba(0, 0, 0, 0); }
.overlay-grip { flex-shrink: 0; }
.overlay-in-row .overlay-grip-vertical { width: 1px; height: 14px; margin-left: 3px; margin-right: 4px; background-color: #00000060; border-right-width: 1px; border-right-color: #ffffff0c; }
.overlay-in-row .overlay-grip-vertical.last { background-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); }
.overlay-top-end .overlay-in-row .overlay-grip-vertical { background-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); margin-left: 0px; margin-right: 2px; }
.overlay-toolbar, .overlay-toolbar-vertical { margin-bottom: 4px; padding: 2px; background-color: #303030e8; border-width: 1px; border-color: #1a1a1a; border-radius: 3px; }
.overlay-in-row.overlay-toolbar { margin: 0px; padding: 0px; background-color: rgba(0, 0, 0, 0); border-width: 0px; }
.overlay-toolbar .overlay-grip-vertical { width: 6px; height: 16px; margin-right: 2px; background-image: url("../Skin/Icons/GripVertical.png"); -helix-background-image-tint-color: var(--hx-text-dim); }
.overlay-toolbar-vertical .overlay-grip-horizontal { width: 16px; height: 6px; margin-bottom: 2px; background-image: url("../Skin/Icons/GripHorizontal.png"); -helix-background-image-tint-color: var(--hx-text-dim); }
.overlay-toolbar-vertical .window-tool { margin: 0px; margin-bottom: 1px; width: 24px; height: 22px; }
.overlay-toolbar-vertical .window-tool .icon { width: 16px; height: 16px; }
.overlay-panel { margin-bottom: 4px; min-width: 120px; background-color: #303030ee; border-width: 1px; border-color: #1a1a1a; border-radius: 3px; }
.overlay-header { flex-direction: row; align-items: center; height: 18px; padding-left: 6px; padding-right: 2px; background-color: #3c3c3c; border-bottom-width: 1px; border-bottom-color: #1a1a1a; }
.overlay-header Label { flex-grow: 1; color: var(--hx-text); font-size: var(--hx-small-font-size); }
.overlay-collapse { width: 16px; height: 16px; padding: 0px; margin: 0px; border-width: 0px; background-color: rgba(0, 0, 0, 0); background-image: none; align-items: center; justify-content: center; }
.overlay-collapse .icon { width: 8px; height: 8px; -helix-background-image-tint-color: var(--hx-text-dim); }
.overlay-bare { background-color: rgba(0, 0, 0, 0); }

/* The Game view: the display texture at its place and scale (cut by the viewport), the message without cameras, the
   stats panel at the top right. */
.window-content.viewport.game-viewport { padding: 0px; background-color: #1b1b1b; overflow: hidden; position: relative; align-items: flex-start; justify-content: flex-start; }
.game-image { position: absolute; -helix-background-scale-mode: stretch-to-fill; }
.game-message { position: absolute; left: 0px; right: 0px; top: 0px; bottom: 0px; -helix-text-align: middle-center; color: var(--hx-text); font-size: 16px; white-space: normal; }
.game-stats-panel { position: absolute; top: 6px; right: 6px; padding: 6px; padding-right: 10px; background-color: #202020dd; border-width: 1px; border-color: #101010; border-radius: 3px; }
.game-stats-text { color: var(--hx-text-strong); font-size: var(--hx-small-font-size); white-space: normal; }
.game-scale-label { color: var(--hx-text); font-size: var(--hx-small-font-size); margin-left: 6px; margin-right: 4px; }
.game-scale { width: 110px; margin: 0px; }
.game-scale-value { color: var(--hx-text); font-size: var(--hx-small-font-size); width: 34px; margin-left: 4px; }
