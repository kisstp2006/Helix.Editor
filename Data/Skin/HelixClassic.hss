.hx-tab { background-image: url("HelixClassic/Tab.png"); -helix-slice-left: 7; -helix-slice-top: 7; -helix-slice-right: 7; -helix-slice-bottom: 7; }
.hx-tab-active { background-image: url("HelixClassic/TabActive.png"); -helix-slice-left: 7; -helix-slice-top: 7; -helix-slice-right: 7; -helix-slice-bottom: 7; }
.hx-tab-strip { background-image: url("HelixClassic/TabStrip.png"); -helix-slice-left: 6; -helix-slice-top: 6; -helix-slice-right: 6; -helix-slice-bottom: 6; }
.hx-panel { background-image: url("HelixClassic/Panel.png"); -helix-slice-left: 6; -helix-slice-top: 6; -helix-slice-right: 6; -helix-slice-bottom: 6; }
.hx-header { background-image: url("HelixClassic/Header.png"); -helix-slice-left: 6; -helix-slice-top: 6; -helix-slice-right: 6; -helix-slice-bottom: 6; }
.hx-field { background-image: url("HelixClassic/Field.png"); -helix-slice-left: 7; -helix-slice-top: 7; -helix-slice-right: 7; -helix-slice-bottom: 7; }
.hx-status-bar { background-image: url("HelixClassic/StatusBar.png"); -helix-slice-left: 6; -helix-slice-top: 6; -helix-slice-right: 6; -helix-slice-bottom: 6; }
.hx-menu { background-image: url("HelixClassic/Menu.png"); -helix-slice-left: 16; -helix-slice-top: 16; -helix-slice-right: 16; -helix-slice-bottom: 16; }
.hx-menu-item-hover { background-image: url("HelixClassic/MenuItemHover.png"); -helix-slice-left: 6; -helix-slice-top: 6; -helix-slice-right: 6; -helix-slice-bottom: 6; }
.hx-caption-button-hover { background-image: url("HelixClassic/CaptionButtonHover.png"); -helix-slice-left: 6; -helix-slice-top: 6; -helix-slice-right: 6; -helix-slice-bottom: 6; }
.hx-caption-close-hover { background-image: url("HelixClassic/CaptionCloseHover.png"); -helix-slice-left: 6; -helix-slice-top: 6; -helix-slice-right: 6; -helix-slice-bottom: 6; }
.hx-window-toolbar { background-image: url("HelixClassic/WindowToolbar.png"); -helix-slice-left: 4; -helix-slice-top: 4; -helix-slice-right: 4; -helix-slice-bottom: 4; }
.hx-toolbar-dropdown { background-image: url("HelixClassic/ToolbarDropdown.png"); -helix-slice-left: 4; -helix-slice-top: 4; -helix-slice-right: 4; -helix-slice-bottom: 4; }
.hx-toolbar-button-hover { background-image: url("HelixClassic/ToolbarButtonHover.png"); -helix-slice-left: 4; -helix-slice-top: 4; -helix-slice-right: 4; -helix-slice-bottom: 4; }
.hx-toolbar-button-on { background-image: url("HelixClassic/ToolbarButtonOn.png"); -helix-slice-left: 4; -helix-slice-top: 4; -helix-slice-right: 4; -helix-slice-bottom: 4; }
