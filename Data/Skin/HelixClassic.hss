/* The skin HelixClassic: written by Tools/GenerateSkin.py from Skins/HelixClassic.json. */
:root {
    --hx-text: #d2d2d2;
    --hx-text-dim: #9a9a9a;
    --hx-text-strong: #f0f0f0;
    --hx-accent: #3a8ee6;
    --hx-accent-text: #ffffff;
    --hx-selection: #2c5d87;
    --hx-window: #232323;
    --hx-panel: #383838;
    --hx-panel-dark: #2e2e2e;
    --hx-separator: #1a1a1a;
    --hx-font-size: 12px;
    --hx-title-font-size: 12px;
    --hx-small-font-size: 11px;
    --hx-title-bar-height: 26px;
    --hx-logo-size: 18px;
    --hx-caption-button-width: 40px;
    --hx-caption-icon-size: 14px;
    --hx-menu-bar-height: 20px;
    --hx-menu-title-padding: 7px;
    --hx-menu-item-height: 20px;
    --hx-menu-padding: 3px;
    --hx-toolbar-height: 30px;
    --hx-tool-button-width: 28px;
    --hx-tool-button-height: 22px;
    --hx-tool-icon-size: 16px;
    --hx-toolbar-dropdown-height: 20px;
    --hx-toolbar-dropdown-width: 90px;
    --hx-toolbar-gap: 6px;
    --hx-tab-strip-height: 21px;
    --hx-tab-height: 19px;
    --hx-tab-active-height: 21px;
    --hx-tab-padding: 8px;
    --hx-tab-icon-size: 14px;
    --hx-tab-close-size: 12px;
    --hx-window-toolbar-height: 23px;
    --hx-window-control-height: 18px;
    --hx-window-icon-size: 14px;
    --hx-window-search-width: 140px;
    --hx-window-dropdown-width: 60px;
    --hx-window-dropdown-wide-width: 100px;
    --hx-window-padding: 6px;
    --hx-status-bar-height: 20px;
    --hx-status-logo-size: 14px;
    --hx-splitter-size: 3px;
    --hx-area-min-size: 60px;
    --hx-float-padding: 12px;
    --hx-drag-threshold: 6px;
    --hx-float-width: 360px;
    --hx-float-height: 260px;
    --hx-float-grab-x: 40px;
    --hx-float-grab-y: 10px;
    --hx-window-x: 120px;
    --hx-window-y: 120px;
    --hx-window-width: 400px;
    --hx-window-height: 300px;
}
.hx-title-bar { background-image: url("HelixClassic/TitleBar.png"); -helix-slice-left: 6; -helix-slice-top: 6; -helix-slice-right: 6; -helix-slice-bottom: 6; }
.hx-menu-bar { background-image: url("HelixClassic/MenuBar.png"); -helix-slice-left: 6; -helix-slice-top: 6; -helix-slice-right: 6; -helix-slice-bottom: 6; }
.hx-toolbar { background-image: url("HelixClassic/Toolbar.png"); -helix-slice-left: 6; -helix-slice-top: 6; -helix-slice-right: 6; -helix-slice-bottom: 6; }
.hx-button { background-image: url("HelixClassic/Button.png"); -helix-slice-left: 7; -helix-slice-top: 7; -helix-slice-right: 7; -helix-slice-bottom: 7; }
.hx-button-hover { background-image: url("HelixClassic/ButtonHover.png"); -helix-slice-left: 7; -helix-slice-top: 7; -helix-slice-right: 7; -helix-slice-bottom: 7; }
.hx-button-pressed { background-image: url("HelixClassic/ButtonPressed.png"); -helix-slice-left: 7; -helix-slice-top: 7; -helix-slice-right: 7; -helix-slice-bottom: 7; }
.hx-button-on { background-image: url("HelixClassic/ButtonOn.png"); -helix-slice-left: 7; -helix-slice-top: 7; -helix-slice-right: 7; -helix-slice-bottom: 7; }
