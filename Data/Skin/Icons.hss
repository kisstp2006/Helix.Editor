/* The editor's icons: written by Tools/GenerateIcons.py. An element of the class icon-<name> shows one. */
.icon-minimize { background-image: url("Icons/Minimize.png"); }
.icon-maximize { background-image: url("Icons/Maximize.png"); }
.icon-restore { background-image: url("Icons/Restore.png"); }
.icon-close { background-image: url("Icons/Close.png"); }
.icon-play { background-image: url("Icons/Play.png"); }
.icon-pause { background-image: url("Icons/Pause.png"); }
.icon-step { background-image: url("Icons/Step.png"); }
.icon-tool-view { background-image: url("Icons/ToolView.png"); }
.icon-tool-move { background-image: url("Icons/ToolMove.png"); }
.icon-tool-rotate { background-image: url("Icons/ToolRotate.png"); }
.icon-tool-scale { background-image: url("Icons/ToolScale.png"); }
.icon-tool-rect { background-image: url("Icons/ToolRect.png"); }
.icon-arrow-down { background-image: url("Icons/ArrowDown.png"); }
.icon-lock { background-image: url("Icons/Lock.png"); }
.icon-search { background-image: url("Icons/Search.png"); }
.icon-menu { background-image: url("Icons/Menu.png"); }
.icon-help { background-image: url("Icons/Help.png"); }
.icon-layers { background-image: url("Icons/Layers.png"); }
.icon-light { background-image: url("Icons/Light.png"); }
.icon-effects { background-image: url("Icons/Effects.png"); }
.icon-grid { background-image: url("Icons/Grid.png"); }
.icon-info { background-image: url("Icons/Info.png"); }
.icon-warning { background-image: url("Icons/Warning.png"); }
.icon-error { background-image: url("Icons/Error.png"); }
.icon-window-hierarchy-window { background-image: url("Icons/WindowHierarchyWindow.png"); }
.icon-window-scene-view { background-image: url("Icons/WindowSceneView.png"); }
.icon-window-game-view { background-image: url("Icons/WindowGameView.png"); }
.icon-window-inspector-window { background-image: url("Icons/WindowInspectorWindow.png"); }
.icon-window-project-window { background-image: url("Icons/WindowProjectWindow.png"); }
.icon-window-console-window { background-image: url("Icons/WindowConsoleWindow.png"); }
