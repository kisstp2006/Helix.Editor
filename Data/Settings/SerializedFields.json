{
  "comment": "The serialized fields every inspector leaves out (NextVisible skips them): the editor's bookkeeping of an object, and a component's enabled flag (its header's toggle).",
  "hidden": ["m_ObjectHideFlags", "m_GameObject", "m_CorrespondingSourceObject", "m_PrefabInstance", "m_PrefabAsset",
             "m_EditorHideFlags", "m_EditorClassIdentifier", "m_Enabled"],
  "comment2": "Struct type names as SerializedPropertyType's kinds, with the fields they are made of.",
  "types": {
    "Vector2f": ["Vector2", "x", "y"],
    "Vector3f": ["Vector3", "x", "y", "z"],
    "Vector4f": ["Vector4", "x", "y", "z", "w"],
    "Quaternionf": ["Quaternion", "x", "y", "z", "w"],
    "ColorRGBA": ["Color", "r", "g", "b", "a"],
    "Rectf": ["Rect", "x", "y", "width", "height"],
    "AABB": ["Bounds", "m_Center", "m_Extent"],
    "Vector2Int": ["Vector2Int", "x", "y"],
    "Vector3Int": ["Vector3Int", "x", "y", "z"],
    "RectInt": ["RectInt", "x", "y", "width", "height"],
    "BoundsInt": ["BoundsInt", "m_Position", "m_Size"],
    "Hash128": ["Hash128"],
    "BitField": ["LayerMask", "m_Bits"]
  }
}
