{
  "name": "HelixClassic",
  "comment": "The editor's skin of depth: each part a 9-slice image drawn by Tools/GenerateSkin.py (a vertical gradient, a border, a lit top line, a shaded bottom line, an inner shadow, round corners, an outer drop shadow) and its style class in the skin's style sheet.",
  "colors": {
    "text": "#d2d2d2",
    "textDim": "#9a9a9a",
    "textStrong": "#f0f0f0",
    "accent": "#3a8ee6",
    "accentText": "#ffffff",
    "selection": "#2c5d87",
    "window": "#232323",
    "panel": "#383838",
    "panelDark": "#2e2e2e",
    "separator": "#1a1a1a"
  },
  "parts": {
    "TitleBar":      {"size": [24, 24], "slice": 6, "top": "#2f2f2f", "bottom": "#1f1f1f", "border": null, "highlight": "#ffffff10", "shade": "#00000060"},
    "MenuBar":       {"size": [24, 24], "slice": 6, "top": "#323232", "bottom": "#2a2a2a", "border": null, "highlight": "#ffffff0c", "shade": "#00000080"},
    "Toolbar":       {"size": [24, 24], "slice": 6, "top": "#3d3d3d", "bottom": "#2c2c2c", "border": null, "highlight": "#ffffff18", "shade": "#000000a0"},
    "Button":        {"size": [24, 24], "slice": 7, "top": "#585858", "bottom": "#3c3c3c", "border": "#141414", "radius": 3, "highlight": "#ffffff30", "shade": "#00000040"},
    "ButtonHover":   {"size": [24, 24], "slice": 7, "top": "#646464", "bottom": "#454545", "border": "#141414", "radius": 3, "highlight": "#ffffff38", "shade": "#00000040"},
    "ButtonPressed": {"size": [24, 24], "slice": 7, "top": "#262626", "bottom": "#363636", "border": "#101010", "radius": 3, "highlight": null, "shade": null, "inner": "#00000090"},
    "ButtonOn":      {"size": [24, 24], "slice": 7, "top": "#4aa0f0", "bottom": "#2a6cb8", "border": "#0e2f54", "radius": 3, "highlight": "#ffffff50", "shade": "#00000040"},
    "Dropdown":      {"size": [24, 24], "slice": 7, "top": "#4c4c4c", "bottom": "#363636", "border": "#141414", "radius": 3, "highlight": "#ffffff28", "shade": "#00000040"},
    "Tab":           {"size": [24, 24], "slice": 7, "top": "#353535", "bottom": "#2a2a2a", "border": "#161616", "radius": 4, "corners": "top", "highlight": "#ffffff14", "shade": null},
    "TabActive":     {"size": [24, 24], "slice": 7, "top": "#474747", "bottom": "#383838", "border": "#161616", "radius": 4, "corners": "top", "highlight": "#ffffff30", "shade": null, "open": "bottom"},
    "TabStrip":      {"size": [24, 24], "slice": 6, "top": "#262626", "bottom": "#212121", "border": null, "highlight": null, "shade": "#00000080"},
    "Panel":         {"size": [24, 24], "slice": 6, "top": "#3a3a3a", "bottom": "#363636", "border": "#161616", "highlight": "#ffffff0c", "shade": null},
    "Header":        {"size": [24, 24], "slice": 6, "top": "#4a4a4a", "bottom": "#3c3c3c", "border": "#1c1c1c", "highlight": "#ffffff22", "shade": "#00000050"},
    "Field":         {"size": [24, 24], "slice": 7, "top": "#262626", "bottom": "#2c2c2c", "border": "#121212", "radius": 2, "highlight": null, "shade": "#ffffff10", "inner": "#00000070"},
    "StatusBar":     {"size": [24, 24], "slice": 6, "top": "#2a2a2a", "bottom": "#1c1c1c", "border": null, "highlight": "#ffffff14", "shade": null},
    "Menu":          {"size": [32, 32], "slice": 10, "top": "#3c3c3c", "bottom": "#353535", "border": "#121212", "radius": 2, "highlight": "#ffffff14", "shade": null, "drop": 6},
    "MenuItemHover": {"size": [24, 24], "slice": 6, "top": "#4596e8", "bottom": "#2f72c0", "border": null, "radius": 2, "highlight": "#ffffff30", "shade": null},
    "CaptionButtonHover": {"size": [24, 24], "slice": 6, "top": "#4a4a4a", "bottom": "#3a3a3a", "border": null, "highlight": "#ffffff18", "shade": null},
    "CaptionCloseHover":  {"size": [24, 24], "slice": 6, "top": "#e04848", "bottom": "#b42c2c", "border": null, "highlight": "#ffffff30", "shade": null},
    "Shadow":        {"size": [48, 48], "slice": 20, "top": "#00000000", "bottom": "#00000000", "border": null, "highlight": null, "shade": null, "drop": 12}
  }
}
